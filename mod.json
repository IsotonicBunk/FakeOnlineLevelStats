{
	"geode": "5.10.1",
	"gd": {
		"win": "2.2081",
		"android": "2.2081",
		"mac": "2.2081",
		"ios": "2.2081"
	},
	"id": "isotonicbunk.fake-online-level-stats",
	"name": "Fake Level Stats",
	"version": "v1.1.5",
	"developer": "isotonicbunk",
	"description": "Fake likes and downloads on your levels",
	"tags": ["online", "interface", "utility"],
	"dependencies": {
		"geode.node-ids": ">=v1.23.3"
	},
	"links": {
		"source": "https://github.com/IsotonicBunk/FakeOnlineLevelStats"
	},
	"resources": {
		"files": [
			"resources/oops.png"
		]
	},
	"settings": {
		"general-title": {
            "type": "title",
            "name": "General Settings"
        },
		"enabled": {
			"type": "bool",
			"name": "Enable",
			"default": false,
			"description": "Enable fake stats."
		},
		"show-btn": {
			"type": "bool",
			"name": "Show mod settings button",
			"default": true,
			"description": "Show button in level menu that opens this mod settings."
		},
		"change-title": {
            "type": "title",
            "name": "Change Stats"
        },
		"change-downloads": {
			"type": "bool",
			"name": "Custom amount of downloads",
			"default": true
		},
		"downloads-amount": {
			"type": "int",
			"name": "Amount of downloads",
			"default": 0,
			"enable-if": "change-downloads"
		},
		"change-likes": {
			"type": "bool",
			"name": "Custom amount of likes",
			"default": true
		},
		"likes-amount": {
			"type": "int",
			"name": "Amount of likes",
			"default": 0,
			"enable-if": "change-likes"
		},
		"misc-title": {
            "type": "title",
            "name": "Misc Settings"
        },
		"change-is-dislike": {
			"type": "bool",
			"name": "change icon likes/dislikes",
			"default": false
		},
		"is-dislike": {
			"type": "bool",
			"name": "Is disliked?",
			"default": false,
			"description": "Show dislike icon, instead of like",
			"enable-if": "change-is-dislike"
		},
		"change-length": {
			"type": "bool",
			"name": "Custom level length",
			"default": false
		},
		"length": {
			"type": "string",
			"name": "Level length",
			"default": "Long",
			"enable-if": "change-length"
		}
	}
}
